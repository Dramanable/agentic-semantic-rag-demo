# Without any key the demo runs fully locally:
# local embeddings and "extractive" answers (the best matching passage, nothing invented).
#
# Keep comments on their own line: a trailing "# comment" after a value would become part of the value.

# --- LLM ---------------------------------------------------------------
# One of: extractive | openai | anthropic | mistral | ollama | openai_compatible
LLM_PROVIDER=extractive
# Empty = the provider's default model
LLM_MODEL=
LLM_API_KEY=
# Only for ollama / openai_compatible (Groq, vLLM, LM Studio, Together...)
LLM_BASE_URL=

# --- Embeddings --------------------------------------------------------
# One of: fastembed (local, default) | openai | mistral | ollama | openai_compatible
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=

# --- Vector store ------------------------------------------------------
# One of: chroma | memory
VECTOR_STORE_PROVIDER=chroma

# --- Chunking ----------------------------------------------------------
# Max characters per passage. Keep it under the embeddings model window:
# the default local model reads ~128 tokens (~500 characters) and ignores the rest.
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Retrieval ---------------------------------------------------------
# Passages retrieved per search
TOP_K=4
# Minimum similarity (0-1) for a passage to count as relevant; below it, no answer
RELEVANCE_THRESHOLD=0.45
# Query rewrites attempted before giving up
MAX_REWRITES=1
# Confidence buckets on the best source similarity (calibrate with `make eval`)
CONFIDENCE_HIGH=0.6
CONFIDENCE_MEDIUM=0.45

# --- Optional LangSmith tracing of every LangChain/LangGraph call ------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=semantic-rag-demo
# EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
