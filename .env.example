# Without any key the demo runs fully locally:
# local embeddings and "extractive" answers (the retrieved passages, nothing invented).

# --- LLM ---------------------------------------------------------------
# extractive | openai | anthropic | mistral | ollama | openai_compatible
LLM_PROVIDER=extractive
LLM_MODEL=              # empty = the provider's default model
LLM_API_KEY=
LLM_BASE_URL=           # ollama / openai_compatible (Groq, vLLM, LM Studio, Together...)

# --- Embeddings --------------------------------------------------------
# fastembed (local) | openai | mistral | ollama | openai_compatible
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=

# --- Vector store ------------------------------------------------------
# chroma | memory
VECTOR_STORE_PROVIDER=chroma

# --- Retrieval ---------------------------------------------------------
TOP_K=4
RELEVANCE_THRESHOLD=0.45
MAX_REWRITES=1
# Confidence buckets on the best source similarity (calibrate with `make eval`)
CONFIDENCE_HIGH=0.6
CONFIDENCE_MEDIUM=0.45

# --- Optional LangSmith tracing of every LangChain/LangGraph call ------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=semantic-rag-demo
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region
